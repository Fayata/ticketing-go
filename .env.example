# Server
PORT=3003
BASE_PATH=/Ticketing
BASE_URL=http://localhost:3003

# Microservice Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TICKET_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
ADMIN_SERVICE_PORT=8084

# Service URLs (for gateway)
AUTH_SERVICE_URL=http://localhost:8081
TICKET_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
ADMIN_SERVICE_URL=http://localhost:8084

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_strong_password_here
DB_NAME=ticketing_db
DB_SSLMODE=require

# Security & Sessions
SESSION_SECRET=generate-a-strong-random-secret-min-32-chars
SESSION_SECURE=true
JWT_SECRET=generate-another-strong-random-secret-min-32-chars
DEBUG=false

# Google AI (Optional)
GEMINI_API_KEY=your_api_key_here

# Email (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@example.com
